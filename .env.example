# Copy to .env and fill in. .env is gitignored; never commit real keys.
#   cp .env.example .env

ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional model overrides. These are read at call time, so setting them here
# works (an earlier version read them at import time, before .env was loaded,
# so the documented override silently did nothing).
# ANTHROPIC_VLM_MODEL=claude-sonnet-5
# ANTHROPIC_LLM_MODEL=claude-sonnet-5
